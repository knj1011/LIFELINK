<%@ Page Title="About Us" Language="C#" MasterPageFile="~/Site.Master"
    AutoEventWireup="true" CodeBehind="About.aspx.cs"
    Inherits="Lifelink.About" %>

<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">

    <!-- ================= ABOUT HERO ================= -->

    <section class="about-hero">

        <div class="about-container">

            <div class="about-hero-content">

                <span class="about-label">
                    ABOUT LIFELINK
                </span>

                <h1>
                    Connecting People,<br />
                    <span>Creating Hope.</span>
                </h1>

                <p>
                    LifeLink is a community support platform designed to
                    connect people who need help with people who are ready
                    to make a difference.
                </p>

            </div>

        </div>

    </section>


    <!-- ================= OUR MISSION ================= -->

    <section class="about-mission">

        <div class="about-container about-two-column">

            <div class="about-content">

                <span class="about-label">
                    OUR MISSION
                </span>

                <h2>
                    Making Community Support
                    <span>Simple and Accessible.</span>
                </h2>

                <p>
                    LifeLink aims to make it easier for people to find
                    essential support when they need it most.
                </p>

                <p>
                    From blood assistance and food support to emergency
                    requests and volunteer services, LifeLink brings
                    different forms of community help together in one
                    convenient platform.
                </p>

            </div>

            <div class="about-info-card">

                <div class="about-card-icon">
                    ♥
                </div>

                <h3>
                    Together We Can Help
                </h3>

                <p>
                    Every request matters and every helping hand can
                    create a positive impact.
                </p>

            </div>

        </div>

    </section>


    <!-- ================= WHAT WE DO ================= -->

    <section class="about-services">

        <div class="about-container">

            <div class="about-section-heading">

                <span class="about-label">
                    WHAT WE DO
                </span>

                <h2>
                    Supporting People Through
                    <span>Different Needs.</span>
                </h2>

                <p>
                    LifeLink provides a simple way to request, find and
                    provide community assistance.
                </p>

            </div>


            <div class="about-feature-grid">

                <div class="about-feature-card">

                    <div class="about-feature-icon">
                        🩸
                    </div>

                    <h3>
                        Blood Assistance
                    </h3>

                    <p>
                        Help people find blood donors and submit blood
                        requests when urgent support is required.
                    </p>

                </div>


                <div class="about-feature-card">

                    <div class="about-feature-icon">
                        🍲
                    </div>

                    <h3>
                        Food Assistance
                    </h3>

                    <p>
                        Connect people who need food support with
                        available community resources.
                    </p>

                </div>


                <div class="about-feature-card">

                    <div class="about-feature-icon">
                        🚨
                    </div>

                    <h3>
                        Emergency Support
                    </h3>

                    <p>
                        Provide a platform where users can raise
                        emergency requests and seek timely help.
                    </p>

                </div>


                <div class="about-feature-card">

                    <div class="about-feature-icon">
                        🤝
                    </div>

                    <h3>
                        Volunteer Community
                    </h3>

                    <p>
                        Encourage people to volunteer their time and
                        skills to support others in their community.
                    </p>

                </div>

            </div>

        </div>

    </section>

</asp:Content>