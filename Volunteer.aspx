<%@ Page Title="Volunteer" Language="C#" MasterPageFile="~/Site.Master"
    AutoEventWireup="true" CodeBehind="Volunteer.aspx.cs"
    Inherits="Lifelink.Volunteer" %>

<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">

    <section class="volunteer-hero">

        <div class="volunteer-container">

            <div class="volunteer-hero-content">

                <span class="volunteer-label">
                    VOLUNTEER WITH LIFELINK
                </span>

                <h1>
                    Be Someone's<br />
                    <span>Helping Hand.</span>
                </h1>

                <p>
                    Give your time, skills and support to people in
                    your community who need help.
                </p>

                <a href="BecomeVolunteer.aspx" class="primary-btn">
                    Become a Volunteer
                </a>

            </div>

            <div class="volunteer-hero-card">

                <div class="volunteer-card-icon">
                    🤝
                </div>

                <h3>
                    Every Helping Hand Matters
                </h3>

                <p>
                    Small actions can create a meaningful difference
                    in someone's life.
                </p>

            </div>

        </div>

    </section>


    <section class="volunteer-roles">

        <div class="volunteer-container">

            <div class="volunteer-heading">

                <span class="volunteer-label">
                    HOW YOU CAN HELP
                </span>

                <h2>
                    Volunteer Opportunities
                </h2>

                <p>
                    Choose how you would like to support your community
                    through LifeLink.
                </p>

            </div>


            <div class="volunteer-grid">

                <div class="volunteer-card">

                    <div class="volunteer-icon">
                        🩸
                    </div>

                    <h3>
                        Blood Donation
                    </h3>

                    <p>
                        Register as a blood donor and help people
                        who need blood during critical situations.
                    </p>

                </div>


                <div class="volunteer-card">

                    <div class="volunteer-icon">
                        🍲
                    </div>

                    <h3>
                        Food Support
                    </h3>

                    <p>
                        Help distribute or arrange food support for
                        people and families in need.
                    </p>

                </div>


                <div class="volunteer-card">

                    <div class="volunteer-icon">
                        🚨
                    </div>

                    <h3>
                        Emergency Assistance
                    </h3>

                    <p>
                        Assist with community requests where timely
                        support can make a difference.
                    </p>

                </div>


                <div class="volunteer-card">

                    <div class="volunteer-icon">
                        🤝
                    </div>

                    <h3>
                        Community Support
                    </h3>

                    <p>
                        Offer your time and skills to support people
                        facing different challenges.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <section class="volunteer-process">

        <div class="volunteer-container">

            <div class="volunteer-heading">

                <span class="volunteer-label">
                    HOW IT WORKS
                </span>

                <h2>
                    Start Helping in Three Steps
                </h2>

            </div>


            <div class="volunteer-steps">

                <div class="volunteer-step">

                    <div class="step-number">
                        01
                    </div>

                    <h3>
                        Register
                    </h3>

                    <p>
                        Create your volunteer profile and provide
                        the required information.
                    </p>

                </div>


                <div class="volunteer-step">

                    <div class="step-number">
                        02
                    </div>

                    <h3>
                        Find Opportunities
                    </h3>

                    <p>
                        Explore volunteer requests and choose
                        where you can provide support.
                    </p>

                </div>


                <div class="volunteer-step">

                    <div class="step-number">
                        03
                    </div>

                    <h3>
                        Make a Difference
                    </h3>

                    <p>
                        Respond to requests and help someone
                        in your community.
                    </p>

                </div>

            </div>

        </div>

    </section>

</asp:Content>